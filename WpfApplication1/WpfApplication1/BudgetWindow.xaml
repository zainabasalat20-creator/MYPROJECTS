<Window x:Class="FinanceTrackerAppWPF.BudgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budget Window" Height="400" Width="400"
        Background="SkyBlue">
    <Grid Margin="10">
        <StackPanel>
            <Image Source="images/images.jpeg" Width="282" Height="166" Margin="0,0,0,0"/>
            <TextBlock Text="Enter Income:" FontSize="16" Margin="0,10"/>
            <TextBox Name="txtIncome" Width="200" Height="30" Margin="0,5"/>

            <Button Name="btnDivideBudget" Content="Divide Budget" Width="200" Height="40" 
                    Margin="0,10" Click="DivideBudget_Click"/>

            <TextBlock Name="txtBreakdown" FontSize="14" Margin="0,20"/>
        </StackPanel>
    </Grid>
</Window>
