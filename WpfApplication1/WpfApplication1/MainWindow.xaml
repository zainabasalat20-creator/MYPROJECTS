<Window x:Class="FinanceTrackerAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome" Height="400" Width="600" Background="SkyBlue">
    <Grid>
        <TextBlock Text="Welcome! Expense Tracker" 
                   FontSize="24" FontWeight="Bold" Foreground="DarkBlue"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>

        <Image Source="images/1.jpeg" Width="185" Height="130" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="188,75,205,0"/>

        <ProgressBar x:Name="progressBar" Minimum="0" Maximum="100" Value="0"
                     Height="30" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="133,234,145,97" />

        <Button x:Name="btnNext" Content="Next" Width="100" Height="30"
                VerticalAlignment="Bottom" Margin="0,0,0,30" Click="Next_Click" IsEnabled="False"/>
    </Grid>
</Window>
