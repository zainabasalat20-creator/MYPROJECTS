<Window x:Class="PersonalFinanceTracker.BudgetDivision"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budget Division" Height="500" Width="600" Background="LightGray">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

            <TextBlock Text="Your Budget" FontSize="24" Foreground="White" Margin="0,0,0,20" TextAlignment="Center"/>

            <TextBlock Text="Enter your income in PKR" FontSize="16" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="incomeTextBox" Width="200" Height="30" Margin="0,0,0,20"/>

            <TextBlock Text="Select Option" FontSize="16" Foreground="White" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <RadioButton x:Name="weeklyRadio" Content="Weekly" Foreground="White" Margin="10,0"/>
                <RadioButton x:Name="monthlyRadio" Content="Monthly" Foreground="White" Margin="10,0"/>
            </StackPanel>

            <Button Content="Divide Budget" Width="150" Height="30" Click="DivideBudget_Click" Margin="0,0,0,20"/>

            <TextBlock Text="Division of Budget" FontSize="16" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock x:Name="budgetDivisionTextBlock" FontSize="14" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

            <Button Content="Next" Width="100" Height="30" Click="Next_Click"/>

        </StackPanel>
    </Grid>
</Window>
